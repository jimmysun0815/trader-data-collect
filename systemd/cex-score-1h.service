[Unit]
Description=CEX Score Daemon (1h) - v3 normalizer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/trader-data-collect
# 必须用 venv 的 python3（MLP 需要 torch/numpy 等）
ExecStart=/home/ubuntu/trader-data-collect/venv/bin/python3 /home/ubuntu/trader-data-collect/cex_score_daemon_v2.py --symbol btc --window 1h --port 9002 --hot-dir /home/ubuntu/trader-data-collect/real_hot --lookback-s 21600 --decay-T 60 --decay-lambda-base 0.02 --decay-sigma 6 --decay-multiplier 0.5 --decay-min-mu 8 --decay-max-mu 60 --decay-N-windows 10 --use-zeff-model

# 自动重启
Restart=always
RestartSec=10

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cex-score-1h

# 资源限制（使用新语法）
MemoryMax=512M
CPUQuota=50%

# 环境变量：确保使用 venv（PATH 优先 venv/bin，MLP 需 torch/numpy/pandas 等）
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/home/ubuntu/trader-data-collect/venv/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=multi-user.target
