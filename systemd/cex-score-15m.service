[Unit]
Description=CEX Score Daemon (15m) - v3 normalizer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/trader-data-collect
# 使用 cex_score_daemon_v2（已改为从 cex_scorer_v3 导入）
# 启用 MLP zeff：在下面 ExecStart 末尾加 --use-zeff-model（模型路径已硬编码为 /home/ubuntu/trader-data-collect/model/zeff_mlp_model.pth）
ExecStart=/home/ubuntu/trader-data-collect/venv/bin/python3 -m collect_data.cex_score_daemon_v2 --symbol btc --window 15m --port 9001 --hot-dir /home/ubuntu/trader-data-collect/real_hot

# 自动重启
Restart=always
RestartSec=10

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cex-score-15m

# 资源限制（使用新语法）
MemoryMax=512M
CPUQuota=50%

# 环境变量
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
