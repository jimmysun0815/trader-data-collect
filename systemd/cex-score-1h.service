[Unit]
Description=CEX Score Daemon (1h) - v3 normalizer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/trader-data-collect
# 使用 cex_score_daemon_v2（已改为从 cex_scorer_v3 导入）；启用 MLP zeff 时加 --use-zeff-model（模型路径已硬编码）
ExecStart=/home/ubuntu/trader-data-collect/venv/bin/python3 -m collect_data.cex_score_daemon_v2 --symbol btc --window 1h --port 9002 --hot-dir /home/ubuntu/trader-data-collect/real_hot --lookback-s 21600 --decay-T 60 --decay-lambda-base 0.02 --decay-sigma 6 --decay-multiplier 0.5 --decay-min-mu 8 --decay-max-mu 60 --decay-N-windows 10

# 自动重启
Restart=always
RestartSec=10

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cex-score-1h

# 资源限制（使用新语法）
MemoryMax=512M
CPUQuota=50%

# 环境变量
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
